<?php

/**
 * @file
 * Custom news functionality for Mahlzeit.
 */

/**
 * Implements hook_theme().
 */
function mahlzeit_news_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'mahlzeit_news_listing' => [
      'variables' => [
        'items' => [],
        'categories' => [],
        'date_filters' => [],
        'selected_category' => '',
        'selected_date_filter' => 'all',
        'pager' => NULL,
      ],
      'template' => 'news-listing',
      'path' => $path . '/templates',
    ],
    'mahlzeit_news_detail' => [
      'variables' => [
        'item' => [],
      ],
      'template' => 'news-detail',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_cron().
 */
function mahlzeit_news_cron(): void {
  // The service throttles this to one sync every six hours. This keeps the
  // behavior predictable even when the site's cron runs more frequently.
  \Drupal::service('mahlzeit_news.news')->sync(FALSE, TRUE);
}
