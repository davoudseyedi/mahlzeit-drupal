<?php

/**
 * @file
 * Live data preparation for the public Mahlzeit homepage.
 */

/**
 * Implements hook_preprocess_page().
 */
function mahlzeit_homepage_preprocess_page(array &$variables): void {
  if (empty($variables['is_front'])) {
    return;
  }

  $data = \Drupal::service('mahlzeit_homepage.data')->getData();
  $variables['home_exams'] = $data['exams'];
  $variables['home_plans'] = $data['plans'];
  $variables['home_vocabulary'] = $data['vocabulary'];
  $variables['home_news'] = $data['news'];
  $variables['home_blog'] = $data['blog'];
  $variables['#cache']['max-age'] = 300;
  $variables['#cache']['tags'][] = 'node_list';
  $variables['#cache']['tags'][] = 'mahlzeit_news';
  $variables['#cache']['tags'][] = 'mahlzeit_vocabulary';
}
