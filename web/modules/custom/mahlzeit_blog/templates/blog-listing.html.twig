<section class="blog-page">
  <div class="container">
    <header class="blog-hero">
      <div class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{{ 'Fresh from Mahlzeit'|t }}</div>
      <h1>{{ 'The Mahlzeit blog.'|t }}</h1>
      <p>{{ 'Practical German, learning ideas and stories to help you understand more and speak with confidence.'|t }}</p>
    </header>

    {% if categories %}
      <nav class="blog-category-filter" aria-label="{{ 'Filter blog posts by category'|t }}">
        <a class="blog-category-filter__link{% if selected_category == 0 %} is-active{% endif %}" href="{{ all_categories_url }}"{% if selected_category == 0 %} aria-current="page"{% endif %}>{{ 'All categories'|t }}</a>
        {% for category in categories %}
          <a class="blog-category-filter__link{% if selected_category == category.id %} is-active{% endif %}" href="{{ category.url }}"{% if selected_category == category.id %} aria-current="page"{% endif %}>{{ category.label }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    {% if posts %}
      <div class="blog-post-grid">
        {% for post in posts %}
          <article class="blog-post-card">
            <a class="blog-post-card__media {% if not post.image %}blog-post-card__media--{{ post.tone }}{% endif %}" href="{{ post.url }}" aria-label="{{ 'Read @title'|t({'@title': post.title}) }}">
              {% if post.image %}
                {{ post.image }}
              {% else %}
                <span class="blog-post-card__mark" aria-hidden="true">M</span>
                <span class="blog-post-card__label">{{ 'MAHLZEIT'|t }}</span>
              {% endif %}
            </a>
            <div class="blog-post-card__body">
              <div class="blog-post-card__meta"><span>{% if post.category %}{{ post.category }}{% else %}{{ 'German learning'|t }}{% endif %}</span><time datetime="{{ post.date_iso }}">{{ post.date }}</time></div>
              <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
              {% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}
              {% if post.tags %}<div class="blog-post-card__tags" aria-label="{{ 'Article tags'|t }}">{% for tag in post.tags %}<span>#{{ tag }}</span>{% endfor %}</div>{% endif %}
              <a class="blog-post-card__link" href="{{ post.url }}">{{ 'Read article'|t }} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if pager %}<div class="blog-pager">{{ pager }}</div>{% endif %}
    {% else %}
      <div class="blog-empty-state">
        <span class="blog-empty-state__icon" aria-hidden="true">✦</span>
        <h2>{{ 'The next story starts here.'|t }}</h2>
        <p>{{ 'No blog posts have been published yet. Check back soon for practical German learning ideas.'|t }}</p>
        {% if can_create %}<a class="button" href="{{ create_url }}">{{ 'Create the first post'|t }}</a>{% endif %}
      </div>
    {% endif %}
  </div>
</section>
