<section class="consultation-page">
  <div class="container">
    <header class="consultation-hero">
      <div class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{{ 'A little help goes a long way'|t }}</div>
      <h1>{{ 'Let’s find your next step in German.'|t }}</h1>
      <p>{{ 'Request a personal consultation and tell us where you want your German to take you. We will come back with a practical recommendation.'|t }}</p>
    </header>

    <div class="consultation-layout">
      <aside class="consultation-side">
        <div class="consultation-side__card">
          <span class="consultation-side__icon" aria-hidden="true">✦</span>
          <h2>{{ 'What we can help with'|t }}</h2>
          <ul>
            <li><span aria-hidden="true">✓</span>{{ 'Choosing the right learning path'|t }}</li>
            <li><span aria-hidden="true">✓</span>{{ 'Building a speaking routine'|t }}</li>
            <li><span aria-hidden="true">✓</span>{{ 'Finding the right level and scenarios'|t }}</li>
          </ul>
        </div>
        <p class="consultation-side__note">{{ 'No pressure, no complicated placement test — just a useful conversation about your goals.'|t }}</p>
      </aside>

      <div class="consultation-form-card">
        {{ form }}
      </div>
    </div>
  </div>
</section>
