<div class="site-shell">
  {% if page.announcement %}
    <div class="announcement">{{ page.announcement }}</div>
  {% endif %}
  <header class="site-header" data-site-header>
    <div class="container header-inner">
      <a class="site-logo" href="{{ path('<front>') }}" aria-label="{{ 'Mahlzeit home'|t }}">
        <img class="logo-mark" src="{{ base_path ~ directory }}/images/mahlzeit-mark.png" alt="" aria-hidden="true">
        <span class="logo-word">Mahlzeit</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle>
        <span class="visually-hidden">{{ 'Open navigation'|t }}</span>
        <span class="menu-toggle__line"></span><span class="menu-toggle__line"></span><span class="menu-toggle__line"></span>
      </button>
      <nav class="desktop-nav" aria-label="{{ 'Main navigation'|t }}">{{ page.primary_menu }}</nav>
      <div class="header-actions">
        {% if language_switcher %}
          <nav class="language-switcher" aria-label="{{ 'Choose language'|t }}" dir="ltr">
            {% for language in language_switcher %}
              <a class="language-switcher__link{% if language.active %} is-active{% endif %}" href="{{ language.url }}" hreflang="{{ language.code|lower }}" lang="{{ language.code|lower }}"{% if language.active %} aria-current="page"{% endif %}>{{ language.label }}</a>
            {% endfor %}
          </nav>
        {% endif %}
        <a class="button button--small button--secondary" href="{{ path('mahlzeit_consultation.form') }}">{{ 'Request consultation'|t }}</a>
        <a class="button button--small" href="https://app.mahlzeitlab.com">{{ 'Start learning'|t }}</a>
      </div>
    </div>
    <div class="mobile-nav" id="mobile-navigation" data-mobile-nav hidden>
      <div class="container">
        {{ page.primary_menu }}
        {% if language_switcher %}
          <nav class="language-switcher language-switcher--mobile" aria-label="{{ 'Choose language'|t }}" dir="ltr">
            {% for language in language_switcher %}
              <a class="language-switcher__link{% if language.active %} is-active{% endif %}" href="{{ language.url }}" hreflang="{{ language.code|lower }}" lang="{{ language.code|lower }}"{% if language.active %} aria-current="page"{% endif %}>{{ language.label }}</a>
            {% endfor %}
          </nav>
        {% endif %}
        <div class="mobile-nav__actions">
          <a class="button button--secondary button--block" href="{{ path('mahlzeit_consultation.form') }}">{{ 'Request consultation'|t }}</a>
          <a class="button button--block" href="https://app.mahlzeitlab.com">{{ 'Start learning'|t }}</a>
        </div>
      </div>
    </div>
    <button class="mobile-nav-backdrop" type="button" data-mobile-nav-backdrop hidden aria-label="{{ 'Close navigation'|t }}"></button>
  </header>

  {% if page.breadcrumb %}<div class="container breadcrumb-region">{{ page.breadcrumb }}</div>{% endif %}
  {% if page.highlighted %}{{ page.highlighted }}{% endif %}
  {% if page.content_above %}{{ page.content_above }}{% endif %}

  <main id="main-content" class="site-main" tabindex="-1">
    {% if is_front %}
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span>{{ 'German, made practical'|t }}</div>
            <h1>{{ 'Speak German with confidence.'|t }}</h1>
            <p class="hero-lead">{{ 'Mahlzeit combines structured lessons with an AI speaking coach that understands your level, mistakes and progress.'|t }}</p>
            <div class="hero-actions"><a class="button" href="https://app.mahlzeitlab.com">{{ 'Start learning'|t }}</a><a class="button button--secondary" href="#how-it-works">{{ 'Explore how it works'|t }} <span aria-hidden="true">↗</span></a></div>
            <p class="hero-note"><span class="avatar-stack" aria-hidden="true"><i>👩</i><i>👨</i><i>🧑</i></span>{{ 'Built for real conversations, not perfect streaks.'|t }}</p>
          </div>
          <div class="hero-visual" aria-label="{{ 'AI German conversation preview'|t }}">
            <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
            <div class="conversation-card">
              <div class="conversation-top"><span class="status-live"></span><span>{{ 'AI conversation'|t }}</span><span class="level-pill">B1</span></div>
              <div class="coach-message"><span class="coach-avatar">M</span><div><small>{{ 'Mahlzeit Coach'|t }}</small><p>{{ 'Wie war dein Wochenende?'|t }}</p></div></div>
              <div class="user-message"><small>{{ 'You'|t }}</small><p>{{ 'Es war sehr gut. Ich habe meine Freunde getroffen.'|t }}</p></div>
              <div class="feedback-row"><span class="check-icon">✓</span><div><strong>{{ 'Nice work!'|t }}</strong><span>{{ 'Natural past tense · 92% confidence'|t }}</span></div><span class="sparkle">✦</span></div>
              <div class="waveform" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            </div>
            <div class="floating-note note-progress"><span>↗</span><div><b>+18 min</b><small>{{ 'speaking this week'|t }}</small></div></div>
            <div class="floating-note note-german"><span>✓</span><div><b>{{ 'Sehr gut!'|t }}</b><small>{{ 'Keep going'|t }}</small></div></div>
          </div>
        </div>
      </section>

      <section class="value-strip"><div class="container value-grid"><div><span class="value-icon">✦</span><strong>{{ 'AI-powered speaking'|t }}</strong><small>{{ 'Practice at your pace'|t }}</small></div><div><span class="value-icon">⌁</span><strong>{{ 'Real-life German'|t }}</strong><small>{{ 'Learn what people actually say'|t }}</small></div><div><span class="value-icon">◒</span><strong>{{ 'Personal feedback'|t }}</strong><small>{{ 'Know what to improve next'|t }}</small></div><div><span class="value-icon">↗</span><strong>{{ 'Adaptive learning'|t }}</strong><small>{{ 'A plan that remembers you'|t }}</small></div></div></section>

      {% set home_vocabulary = home_vocabulary|default({level: 'B2', title: 'Aufbruch', part_of_speech: 'Substantiv', description: 'Ein neuer Anfang oder der Beginn einer Reise und Veränderung.'}) %}
      <section class="home-vocabulary-strip"><div class="container"><a class="home-vocabulary-card" href="{{ path('mahlzeit_vocabulary.list') }}"><span class="home-vocabulary-card__label"><span aria-hidden="true">✦</span>{{ 'Today’s vocabulary'|t }}</span><span class="home-vocabulary-card__content"><span class="home-vocabulary-card__word" dir="ltr"><span class="vocabulary-level">{{ home_vocabulary.level }}</span><strong>{{ home_vocabulary.title }}</strong><span class="vocabulary-part">{{ home_vocabulary.part_of_speech ?: 'Word'|t }}</span></span><span dir="ltr">{{ 'Learn how this German word is used.'|t }}</span><span class="home-vocabulary-card__link">{{ 'Practise flashcards'|t }} →</span></span></a></div></section>

      <section class="section" id="how-it-works"><div class="container"><div class="section-heading centered"><div class="eyebrow">{{ 'A better learning loop'|t }}</div><h2>{{ 'Learn → Speak → Improve'|t }}</h2><p>{{ 'Everything you need to turn German knowledge into German confidence.'|t }}</p></div><div class="steps-grid"><article class="step-card"><span class="step-number">01</span><div class="step-icon step-icon--learn">⌘</div><h3>{{ 'Learn'|t }}</h3><p>{{ 'Build a strong foundation with structured lessons that make grammar and vocabulary click.'|t }}</p><a href="https://app.mahlzeitlab.com">{{ 'Explore lessons'|t }} <span>→</span></a></article><article class="step-card step-card--featured"><span class="step-number">02</span><div class="step-icon step-icon--speak">◉</div><h3>{{ 'Speak'|t }}</h3><p>{{ 'Practice real conversations with an AI coach that adapts to your level and your interests.'|t }}</p><a href="https://app.mahlzeitlab.com">{{ 'Meet your coach'|t }} <span>→</span></a></article><article class="step-card"><span class="step-number">03</span><div class="step-icon step-icon--improve">↗</div><h3>{{ 'Improve'|t }}</h3><p>{{ 'Get clear feedback and targeted exercises that turn mistakes into your next breakthrough.'|t }}</p><a href="https://app.mahlzeitlab.com">{{ 'See your progress'|t }} <span>→</span></a></article></div></div></section>

      <section class="section section--dark coach-section"><div class="container split-grid"><div class="section-heading"><div class="eyebrow eyebrow--light">{{ 'Your speaking partner'|t }}</div><h2>{{ 'German conversation that feels like practice for real life.'|t }}</h2><p>{{ 'From ordering a coffee to preparing for a job interview, Mahlzeit gives you a safe place to speak more often—and feedback you can actually use.'|t }}</p><a class="button button--yellow" href="https://app.mahlzeitlab.com">{{ 'Try AI speaking'|t }} <span>↗</span></a></div><div class="feature-panel"><div class="panel-header"><span>{{ 'Choose a scenario'|t }}</span><span class="panel-dots">•••</span></div><div class="scenario-list"><div class="scenario active"><span>☕</span><div><b>{{ 'At a café'|t }}</b><small>{{ 'Everyday conversation · A2'|t }}</small></div><i>→</i></div><div class="scenario"><span>💼</span><div><b>{{ 'Job interview'|t }}</b><small>{{ 'Professional German · B1'|t }}</small></div><i>→</i></div><div class="scenario"><span>🏠</span><div><b>{{ 'Finding an apartment'|t }}</b><small>{{ 'Real-life scenario · B2'|t }}</small></div><i>→</i></div></div><div class="panel-footer"><span class="mini-signal"></span>{{ 'Dynamic difficulty on'|t }}<span class="switch"></span></div></div></div></section>

      <section class="section memory-section"><div class="container"><div class="section-heading centered"><div class="eyebrow">{{ 'Personal by design'|t }}</div><h2>{{ 'Your mistakes become your memory.'|t }}</h2><p>{{ 'Every conversation teaches Mahlzeit how to make your next practice session more useful.'|t }}</p></div><div class="memory-flow"><div><span>01</span><b>{{ 'Conversation'|t }}</b><small>{{ 'You speak naturally'|t }}</small></div><i>→</i><div><span>02</span><b>{{ 'Mistakes'|t }}</b><small>{{ 'We spot patterns'|t }}</small></div><i>→</i><div class="memory-highlight"><span>03</span><b>{{ 'Learning memory'|t }}</b><small>{{ 'Your coach remembers'|t }}</small></div><i>→</i><div><span>04</span><b>{{ 'Personal practice'|t }}</b><small>{{ 'You improve faster'|t }}</small></div></div></div></section>

      <section class="section scenarios-section"><div class="container"><div class="section-heading row-heading"><div><div class="eyebrow">{{ 'German for your day'|t }}</div><h2>{{ 'Learn the German you need next.'|t }}</h2></div><a class="text-link" href="https://app.mahlzeitlab.com">{{ 'See all scenarios'|t }} <span>→</span></a></div><div class="scenario-cards"><div class="big-scenario scenario-cafe"><span>☕</span><b>{{ 'At a café'|t }}</b><small>{{ 'A2 · 12 min'|t }}</small></div><div class="big-scenario scenario-work"><span>💬</span><b>{{ 'At work'|t }}</b><small>{{ 'B1 · 18 min'|t }}</small></div><div class="big-scenario scenario-doctor"><span>🩺</span><b>{{ 'At the doctor'|t }}</b><small>{{ 'B1 · 15 min'|t }}</small></div><div class="big-scenario scenario-travel"><span>✈</span><b>{{ 'Travel'|t }}</b><small>{{ 'A2 · 10 min'|t }}</small></div></div></div></section>

      <section class="section feature-section"><div class="container"><div class="section-heading centered"><div class="eyebrow">{{ 'One place to keep going'|t }}</div><h2>{{ 'A complete system for making progress.'|t }}</h2></div><div class="feature-list"><div class="feature-line"><span class="feature-symbol green">◉</span><b>{{ 'Speak more often'|t }}</b><span>{{ 'AI Conversation · Real-life Scenarios · Speaking Missions'|t }}</span><span class="feature-arrow">→</span></div><div class="feature-line"><span class="feature-symbol yellow">✦</span><b>{{ 'Understand more deeply'|t }}</b><span>{{ 'Lessons · Vocabulary · Story Mode · Shadowing'|t }}</span><span class="feature-arrow">→</span></div><div class="feature-line"><span class="feature-symbol red">⌁</span><b>{{ 'See your progress'|t }}</b><span>{{ 'AI Coach · My Mistakes · Weekly Report · Analytics'|t }}</span><span class="feature-arrow">→</span></div></div></div></section>

      <section class="section content-preview-section"><div class="container"><div class="section-heading row-heading"><div><div class="eyebrow">{{ 'Fresh from Mahlzeit'|t }}</div><h2>{{ 'German that keeps you curious.'|t }}</h2></div><a class="text-link" href="{{ path('view.frontpage.page_1') }}">{{ 'Explore the library'|t }} <span>→</span></a></div><div class="preview-grid preview-grid--two"><article class="content-card home-news-card"><div class="card-art card-art--news"><span class="level-badge">B1</span><span class="art-label">{{ 'NEWS'|t }}</span></div><div class="content-card-body"><small>{{ 'German News · 6 min read'|t }}</small><h3>{{ 'Why more people are choosing the train in Germany'|t }}</h3><p>{{ 'Learn useful words and phrases from what is happening around you.'|t }}</p></div></article><article class="content-card blog-card"><div class="card-art card-art--blog"><span class="art-label">{{ 'GUIDE'|t }}</span></div><div class="content-card-body"><small>{{ 'Learning tips · 8 min read'|t }}</small><h3>{{ 'How to stop translating in your head'|t }}</h3><p>{{ 'A practical guide to thinking more naturally in German.'|t }}</p></div></article></div></div></section>

      <section class="section pricing-section"><div class="container pricing-wrap"><div class="section-heading centered"><div class="eyebrow">{{ 'Find your rhythm'|t }}</div><h2>{{ 'A plan that fits the way you learn.'|t }}</h2><p>{{ 'Start free. Build a habit. Unlock your next level when you are ready.'|t }}</p></div><div class="pricing-grid"><div class="price-card"><small>{{ 'Economic'|t }}</small><h3>{{ 'Start steady'|t }}</h3><p>{{ 'The essentials for building a daily German habit.'|t }}</p><a class="button button--secondary button--block" href="https://app.mahlzeitlab.com">{{ 'Get started'|t }}</a></div><div class="price-card price-card--recommended"><span class="recommended">{{ 'Recommended'|t }}</span><small>{{ 'Standard'|t }}</small><h3>{{ 'Go further'|t }}</h3><p>{{ 'More speaking, more feedback, more momentum.'|t }}</p><a class="button button--block" href="https://app.mahlzeitlab.com">{{ 'Start learning'|t }}</a></div><div class="price-card"><small>{{ 'Pro'|t }}</small><h3>{{ 'Go all in'|t }}</h3><p>{{ 'A complete learning system for serious progress.'|t }}</p><a class="button button--secondary button--block" href="https://app.mahlzeitlab.com">{{ 'Get started'|t }}</a></div></div></div></section>

      <section class="final-cta"><div class="container final-cta-inner"><div class="eyebrow eyebrow--light">{{ 'Your German is waiting.'|t }}</div><h2>{{ 'Ready to start speaking German?'|t }}</h2><p>{{ 'Learn German. Simply understand.'|t }}</p><a class="button button--yellow" href="https://app.mahlzeitlab.com">{{ 'Start learning'|t }} <span>↗</span></a></div></section>
    {% endif %}
    {% if auth_page %}
      <section class="auth-page auth-page--{{ auth_page }}" aria-labelledby="auth-title">
        <div class="auth-page__orb auth-page__orb--one" aria-hidden="true"></div>
        <div class="auth-page__orb auth-page__orb--two" aria-hidden="true"></div>
        <div class="container auth-layout">
          <div class="auth-story">
            <div class="auth-story__eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{{ 'Your German, moving forward'|t }}</div>
            <h2>{{ 'Practice that fits real life.'|t }}</h2>
            <p>{{ 'Mahlzeit gives you a simple place to keep learning, speaking and building confidence—one useful conversation at a time.'|t }}</p>
            <ul class="auth-benefits">
              <li><span class="auth-benefit__icon" aria-hidden="true">✓</span><span><strong>{{ 'Pick up where you left off'|t }}</strong><small>{{ 'Your progress stays ready for you.'|t }}</small></span></li>
              <li><span class="auth-benefit__icon" aria-hidden="true">✦</span><span><strong>{{ 'Practice with purpose'|t }}</strong><small>{{ 'Focus on German you can use today.'|t }}</small></span></li>
              <li><span class="auth-benefit__icon" aria-hidden="true">↗</span><span><strong>{{ 'See yourself improve'|t }}</strong><small>{{ 'Turn small sessions into momentum.'|t }}</small></span></li>
            </ul>
            <div class="auth-quote">
              <span class="auth-quote__avatar" aria-hidden="true">M</span>
              <span><small>{{ 'Mahlzeit Coach'|t }}</small><strong>{{ 'Ready when you are.'|t }}</strong></span>
              <span class="auth-quote__spark" aria-hidden="true">✦</span>
            </div>
          </div>

          <div class="auth-panel">
            <div class="auth-card">
              <div class="auth-card__brand"><img class="auth-card__mark" src="{{ base_path ~ directory }}/images/mahlzeit-mark.png" alt="" aria-hidden="true"><span>{{ 'Mahlzeit account'|t }}</span></div>
              <div class="auth-card__intro">
                <span class="auth-eyebrow">
                  {% if auth_page == 'login' %}{{ 'Welcome back'|t }}{% elseif auth_page == 'register' %}{{ 'Get started'|t }}{% else %}{{ 'Account help'|t }}{% endif %}
                </span>
                <h1 id="auth-title">
                  {% if auth_page == 'login' %}{{ 'Welcome back.'|t }}{% elseif auth_page == 'register' %}{{ 'Create your account.'|t }}{% else %}{{ 'Reset your password.'|t }}{% endif %}
                </h1>
                <p>
                  {% if auth_page == 'login' %}{{ 'Log in to continue your German practice.'|t }}{% elseif auth_page == 'register' %}{{ 'Start building a German habit that lasts.'|t }}{% else %}{{ 'We will help you get back into your account.'|t }}{% endif %}
                </p>
              </div>

              {% if auth_page == 'register' and not auth_registration_open %}
                <div class="auth-status auth-status--info" role="status">
                  <span class="auth-status__icon" aria-hidden="true">i</span>
                  <div><strong>{{ 'Registration is currently invite-only.'|t }}</strong><p>{{ 'Please log in with an existing account or contact the Mahlzeit team for access.'|t }}</p></div>
                </div>
              {% else %}
                <div class="auth-form-region">{{ page.content }}</div>
                {% if auth_page == 'login' %}
                  <div class="auth-form-meta"><a href="{{ path('user.pass') }}">{{ 'Forgot your password?'|t }}</a></div>
                {% endif %}
              {% endif %}

              <div class="auth-switch">
                {% if auth_page == 'login' %}
                  {% if auth_registration_open %}
                    <span>{{ 'New to Mahlzeit?'|t }}</span><a href="{{ path('user.register') }}">{{ 'Create an account'|t }}</a>
                  {% else %}
                    <span>{{ 'New accounts are currently invite-only.'|t }}</span>
                  {% endif %}
                {% elseif auth_page == 'register' %}
                  <span>{{ 'Already have an account?'|t }}</span><a href="{{ path('user.login') }}">{{ 'Log in'|t }}</a>
                {% else %}
                  <span>{{ 'Remember your password?'|t }}</span><a href="{{ path('user.login') }}">{{ 'Back to log in'|t }}</a>
                {% endif %}
              </div>
            </div>
            <p class="auth-legal">{{ 'Your learning data stays private and secure.'|t }}</p>
          </div>
        </div>
      </section>
    {% elseif not is_front %}{{ page.content }}{% endif %}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a class="site-logo site-logo--footer" href="{{ path('<front>') }}"><img class="logo-mark" src="{{ base_path ~ directory }}/images/mahlzeit-mark.png" alt="" aria-hidden="true"><span class="logo-word">Mahlzeit</span></a>
        <p>{{ 'Learn German. Simply understand.'|t }}</p>
      </div>
      <div class="footer-column">
        <h2>{{ 'Product'|t }}</h2>
        <ul class="footer-links">
          <li><a href="https://app.mahlzeitlab.com/" target="_blank" rel="noopener noreferrer">{{ 'AI speaking coach'|t }}</a></li>
          <li><a href="https://app.mahlzeitlab.com/" target="_blank" rel="noopener noreferrer">{{ 'Start learning'|t }}</a></li>
          <li><a href="{{ path('mahlzeit_consultation.form') }}">{{ 'Request consultation'|t }}</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h2>{{ 'Learn'|t }}</h2>
        <ul class="footer-links">
          <li><a href="{{ path('mahlzeit_news.list') }}">{{ 'News'|t }}</a></li>
          <li><a href="{{ path('mahlzeit_vocabulary.list') }}">{{ 'Vocabulary'|t }}</a></li>
          <li><a href="{{ path('mahlzeit_blog.list') }}">{{ 'Blog'|t }}</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h2>{{ 'Resources'|t }}</h2>
        <ul class="footer-links">
          <li><a href="https://www.duden.de/" target="_blank" rel="noopener noreferrer">{{ 'Duden dictionary'|t }}</a></li>
          <li><a href="https://www.tagesschau.de/" target="_blank" rel="noopener noreferrer">{{ 'Tagesschau news'|t }}</a></li>
          <li><a href="{{ path('mahlzeit_consultation.form') }}">{{ 'Personal consultation'|t }}</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h2>{{ 'Company'|t }}</h2>
        <ul class="footer-links">
          <li><a href="{{ path('<front>') }}">{{ 'Home'|t }}</a></li>
          <li><a href="{{ path('mahlzeit_consultation.form') }}">{{ 'Contact us'|t }}</a></li>
          <li><a href="https://app.mahlzeitlab.com/" target="_blank" rel="noopener noreferrer">{{ 'Open the app'|t }}</a></li>
        </ul>
      </div>
      <div class="footer-column footer-column--legal">
        <h2>{{ 'Legal'|t }}</h2>
        <ul class="footer-links">
          <li><a href="https://app.mahlzeitlab.com/privacy" target="_blank" rel="noopener noreferrer">{{ 'Privacy'|t }}</a></li>
          <li><a href="https://app.mahlzeitlab.com/terms" target="_blank" rel="noopener noreferrer">{{ 'Terms'|t }}</a></li>
          <li><a href="https://app.mahlzeitlab.com/imprint" target="_blank" rel="noopener noreferrer">{{ 'Imprint'|t }}</a></li>
        </ul>
        <a class="enamad-badge" referrerpolicy="origin" target="_blank" rel="noopener noreferrer" href="https://trustseal.enamad.ir/?id=7805276&amp;Code=btU46dMVmYvBjczSmhFwAZJxMcYOVAHf" aria-label="{{ 'View Mahlzeit eNAMAD trust seal'|t }}"><img referrerpolicy="origin" src="https://trustseal.enamad.ir/logo.aspx?id=7805276&amp;Code=btU46dMVmYvBjczSmhFwAZJxMcYOVAHf" alt="{{ 'eNAMAD trust seal'|t }}" style="cursor:pointer" code="btU46dMVmYvBjczSmhFwAZJxMcYOVAHf" loading="lazy"></a>
      </div>
    </div>
    <div class="container footer-bottom"><span>© {{ 'now'|date('Y') }} Mahlzeit</span><span>{{ 'Made for real conversations.'|t }}</span></div>
  </footer>
</div>
