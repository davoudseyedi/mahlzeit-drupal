{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}
{% macro menu_links(items, attributes, menu_level) %}
  {% if items %}
    <ul{{ attributes.addClass('menu', 'menu-level-' ~ menu_level) }}>
      {% for item in items %}
        <li{{ item.attributes.addClass('menu-item') }}>{{ link(item.title, item.url) }}{% if item.below %}{{ _self.menu_links(item.below, create_attribute(), menu_level + 1) }}{% endif %}</li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
