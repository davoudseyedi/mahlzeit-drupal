# Application
APP_PORT=8080

# Database
DB_NAME=mahlzeit_cms
DB_USER=mahlzeit_app
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password

# Keep the existing value when migrating an existing Drupal installation.
DRUPAL_HASH_SALT=change-this-to-a-long-random-value

# Comma-separated regular expressions accepted by Drupal's trusted host check.
DRUPAL_TRUSTED_HOSTS=^localhost$

# Keep this outside the public web root.
DRUPAL_CONFIG_SYNC_DIRECTORY=/var/www/html/config/sync
